# ===== Zah Hub Discord Bot =====
# Copy this file to ".env" and fill in your values.

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Your application (client) ID from the same page
CLIENT_ID=your-application-id-here

# Optional: a single guild (server) ID to register commands instantly during
# development. Leave blank to register commands globally (can take ~1 hour).
GUILD_ID=

# Default command prefix for legacy text commands (slash commands always work)
PREFIX=!

# Brand accent color for embeds (hex without the #)
BRAND_COLOR=2b2d31
